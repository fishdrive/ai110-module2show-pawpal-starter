classDiagram
    class Owner {
        +str name
        +str email
        +str phone
        +list pets
        +int available_minutes_per_day
        +str preferences
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list
        +set_availability(minutes) None
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +float weight
        +str special_needs
        +list tasks
        +add_task(task) None
        +remove_task(task) None
        +get_pending_tasks() list
        +get_summary() str
    }

    class Task {
        +str title
        +str task_type
        +Pet pet
        +int duration_minutes
        +str priority
        +time due_time
        +str frequency
        +bool is_completed
        +str notes
        +mark_complete() Task
        +reschedule(new_time) None
        +is_overdue() bool
        +is_high_priority() bool
        +get_details() str
    }

    class Scheduler {
        +Owner owner
        +list daily_plan
        +date date
        +generate_daily_plan() list
        +sort_tasks() list
        +detect_conflicts() list
        +get_overdue_tasks() list
        +filter_tasks(pet=None, task_type=None, status=None) list
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler "1" --> "0..*" Task : schedules
