classDiagram
    class Owner {
        +str name
        +str email
        +str phone
        +list~Pet~ pets
        +int available_minutes_per_day
        +dict preferences
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list
        +set_availability(minutes) None
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +float weight
        +str special_needs
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_pending_tasks() list
        +get_summary() str
    }

    class Task {
        +str title
        +str task_type
        +Pet? pet
        +int duration_minutes
        +str priority
        +datetime? due_time
        +datetime? scheduled_start
        +str frequency
        +bool is_completed
        +str notes
        +mark_task_complete(now=None) Optional[Task]
        +mark_complete(now=None) Optional[Task]
        +reschedule(new_time) None
        +is_overdue() bool
        +is_high_priority() bool
        +get_details() str
    }

    class Scheduler {
        +Owner owner
        +list~Task~ daily_plan
        +list~Task~ skipped_tasks
        +date date
        +time start_time
        +generate_daily_plan() list
        +sort_tasks(tasks=None) list
        +sort_by_time(tasks=None) list
        +rank_pet_workloads() list~tuple~Pet,int~~
        +detect_conflicts() list
        +get_overdue_tasks() list
        +filter_tasks(pet: Pet | str=None, task_type=None, status=None) list
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "0..1" --> "0..*" Task : assigned
    Task ..> Task : creates next occurrence
    Scheduler "1" --> "1" Owner : plans for
    Scheduler "1" --> "0..*" Task : daily plan
    Scheduler "1" --> "0..*" Task : skips
